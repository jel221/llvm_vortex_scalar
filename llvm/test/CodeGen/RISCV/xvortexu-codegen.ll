; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv32 -mattr=+m,+f,+zicond,+xvortex,+xvortexu -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; A kernel takes its argument block in u10; the per-thread thread id comes
; from a CSR read into x.

declare void @ext(i32)

; u - x: the uniform value is the first operand.
define void @first_operand(ptr %arg) "vortex-kernel" {
; CHECK-LABEL: first_operand:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw u1, 0(u10)
; CHECK-NEXT:    #APP
; CHECK-NEXT:    csrr a0, tid
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    lw u2, 8(u10)
; CHECK-NEXT:    slli a1, a0, 2
; CHECK-NEXT:    sub a0, u1, a0
; CHECK-NEXT:    add a1, a1, u2
; CHECK-NEXT:    sw a0, 0(a1)
; CHECK-NEXT:    ret
  %n = load i32, ptr %arg
  %tid = call i32 asm sideeffect "csrr $0, 0xcc0", "=r"()
  %d = sub i32 %n, %tid
  %p = getelementptr i8, ptr %arg, i32 8
  %out = load ptr, ptr %p
  %q = getelementptr i32, ptr %out, i32 %tid
  store i32 %d, ptr %q
  ret void
}

; A float at a uniform address read by every thread, and a store of a
; per-thread value at a uniform address.
define void @uniform_base(ptr %arg) "vortex-kernel" {
; CHECK-LABEL: uniform_base:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw u1, 4(u10)
; CHECK-NEXT:    flw fa5, 0(u1)
; CHECK-NEXT:    #APP
; CHECK-NEXT:    csrr a0, tid
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    lw u1, 8(u10)
; CHECK-NEXT:    fcvt.s.wu fa4, a0
; CHECK-NEXT:    fadd.s fa5, fa5, fa4
; CHECK-NEXT:    fsw fa5, 0(u1)
; CHECK-NEXT:    ret
  %p = getelementptr i8, ptr %arg, i32 4
  %src = load ptr, ptr %p
  %f = load float, ptr %src
  %tid = call i32 asm sideeffect "csrr $0, 0xcc0", "=r"()
  %t = uitofp i32 %tid to float
  %s = fadd float %f, %t
  %p2 = getelementptr i8, ptr %arg, i32 8
  %dst = load ptr, ptr %p2
  store float %s, ptr %dst
  ret void
}

; A uniform loop counter compared with zero and a constant built in u.
define void @zero_and_const(ptr %arg) "vortex-kernel" {
; CHECK-LABEL: zero_and_const:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lw u1, 0(u10)
; CHECK-NEXT:    beq u1, u0, .LBB2_3
; CHECK-NEXT:  # %bb.1: # %loop.preheader
; CHECK-NEXT:    addi u2, u0, 0
; CHECK-NEXT:    addi u3, u0, 0
; CHECK-NEXT:  .LBB2_2: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    addi u3, u3, 1
; CHECK-NEXT:    sw u2, 0(u10)
; CHECK-NEXT:    addi u10, u10, 4
; CHECK-NEXT:    addi u2, u2, 1000
; CHECK-NEXT:    bltu u3, u1, .LBB2_2
; CHECK-NEXT:  .LBB2_3: # %exit
; CHECK-NEXT:    ret
entry:
  %n = load i32, ptr %arg
  %z = icmp eq i32 %n, 0
  br i1 %z, label %exit, label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %i.next = add i32 %i, 1
  %v = mul i32 %i, 1000
  %p = getelementptr i32, ptr %arg, i32 %i
  store i32 %v, ptr %p
  %c = icmp ult i32 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

; A uniform value live across a call stays in a callee-saved u register.
define void @across_call(ptr %arg) {
; CHECK-LABEL: across_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sw ra, 12(sp) # 4-byte Folded Spill
; CHECK-NEXT:    sw s0, 8(sp) # 4-byte Folded Spill
; CHECK-NEXT:    sw u16, 4(sp) # 4-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -4
; CHECK-NEXT:    .cfi_offset s0, -8
; CHECK-NEXT:    .cfi_offset u16, -12
; CHECK-NEXT:    mv s0, a0
; CHECK-NEXT:    lw a0, 0(a0)
; CHECK-NEXT:    u.mvx u16, a0
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    call ext
; CHECK-NEXT:    addi u1, u16, 7
; CHECK-NEXT:    sw u1, 0(s0)
; CHECK-NEXT:    lw ra, 12(sp) # 4-byte Folded Reload
; CHECK-NEXT:    lw s0, 8(sp) # 4-byte Folded Reload
; CHECK-NEXT:    lw a0, 4(sp)
; CHECK-NEXT:    u.mvx u16, a0
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    .cfi_restore s0
; CHECK-NEXT:    .cfi_restore u16
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
  %n = load i32, ptr %arg
  %u = call i32 @llvm.riscv.vx.uniform.i32.i32(i32 %n)
  call void @ext(i32 0)
  %m = add i32 %u, 7
  store i32 %m, ptr %arg
  ret void
}

; A barrier on uniform operands takes them from u registers.
define void @uniform_barrier(ptr %arg) "vortex-kernel" {
; CHECK-LABEL: uniform_barrier:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw u1, 4(u10)
; CHECK-NEXT:    addi u2, u0, 1
; CHECK-NEXT:    vx_bar u2, u1
; CHECK-NEXT:    ret
  %p = getelementptr i8, ptr %arg, i32 4
  %n = load i32, ptr %p
  call void @llvm.riscv.vx.bar.i32(i32 1, i32 %n)
  ret void
}

; A value an asm leaves in a u register (the vu constraint) is uniform: the
; address computed from it stays in the u file.
define void @uniform_asm_result(ptr %arg) "vortex-kernel" {
; CHECK-LABEL: uniform_asm_result:
; CHECK:       # %bb.0:
; CHECK-NEXT:    #APP
; CHECK-NEXT:    csrrs u1, 3295, u0
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    lw u1, 64(u1)
; CHECK-NEXT:    sw u1, 0(u10)
; CHECK-NEXT:    ret
  %base = call i32 asm "csrrs $0, 0xcdf, u0", "=^vu"()
  %p = add i32 %base, 64
  %q = inttoptr i32 %p to ptr
  %v = load i32, ptr %q
  store i32 %v, ptr %arg
  ret void
}

declare i32 @llvm.riscv.vx.uniform.i32.i32(i32)
declare void @llvm.riscv.vx.bar.i32(i32, i32)
